# Local development only. Production values should be injected by a secrets manager.

# Server
PORT=3000
DRY_RUN=true
LOG_LEVEL=info
RUN_STATE_PATH=.run-state.json

# Smartsheet auth and global IDs
SMARTSHEET_API_TOKEN=replace-me
SMARTSHEET_CHANGE_AGENT=cmr-project-spin-up
SMARTSHEET_GEN009_TEMPLATE_ID=replace-me
SMARTSHEET_Z_ACTIVE_WORKSPACE_ID=replace-me
SMARTSHEET_Z_ACTIVE_WORKSPACE_NAME=Z-Active Projects-Automation
SMARTSHEET_PROJECT_ROOT_FOLDER_PATH=Gen oh oh nine Folder
SMARTSHEET_PROJECT_FOLDER_NAME_TEMPLATE={projectName} - Project Toolkit
SMARTSHEET_GEN009_SHEET_NAME_TEMPLATE={projectName} Gen 009
SMARTSHEET_MASTER_PROJECT_LIST_SHEET_ID=replace-me
OFFICE_ADMIN_GROUP_ID=replace-me

# Smartsheet master project list columns
MASTER_PROJECT_NUMBER_COLUMN=Project Number
MASTER_PROJECT_NAME_COLUMN=Project Name

# Forwarded Smartsheet alert email labels. The first matching field is used as project type.
PROJECT_TYPE_EMAIL_LABELS=Project Vertical,Project Type,Vertical,Project Plan

# Checklist columns and rows
CHECKLIST_PROJECT_NAME_COLUMN=Project Name
CHECKLIST_PROJECT_NUMBER_COLUMN=Project Number
CHECKLIST_PATTERSON_COLUMN=Paterson
CHECKLIST_STATUS_COLUMN=Status
CHECKLIST_STEP_REF_COLUMN=Step Ref
CHECKLIST_VALUE_COLUMN=Value
CHECKLIST_LINK_COLUMN=Link
CHECKLIST_PROJECT_NAME_ROW_LABEL=Project Name
CHECKLIST_PROJECT_NUMBER_ROW_LABEL=Project Number
CHECKLIST_SIGNED_ROW_LABEL=Signed Contract
CHECKLIST_MANUAL_SUMMARY_ROW_LABEL=Manual Steps Remaining

# Project plan section headings.
PROJECT_PLAN_SECTION_NAMES=Commercial,Residential,Patterson

# Report handling
SMARTSHEET_REPORT_TEMPLATE_NAMES={{Orders Report}},{{Report 2}},{{Report 3}},{{Report 4}},{{Report 5}}
SMARTSHEET_RENAME_REPORTS=false
SMARTSHEET_REPORT_NAME_TEMPLATE={projectNumber} {templateName}
SMARTSHEET_REPORT_ACCOUNT_PLACEHOLDER={{ACCOUNT_NUMBER}}
SMARTSHEET_REPORT_FOLDER_NAME_CONTAINS={{Update Filter}}
SMARTSHEET_ORDERS_REPORT_MATCH=Orders
ORDERS_REPORT_PUBLISH_ACCESS_LEVEL=SHARED

# Microsoft Graph / mailbox webhook. Smartsheet alerts should be delivered to this mailbox.
MS_GRAPH_TENANT_ID=replace-me
MS_GRAPH_CLIENT_ID=replace-me
MS_GRAPH_CLIENT_SECRET=replace-me
MS_GRAPH_MAILBOX_USER_ID=ShilatSSapi@LiviaDesignGroup.com
MS_GRAPH_ONEDRIVE_USER_ID=ShilatSSapi@LiviaDesignGroup.com
WEBHOOK_CALLBACK_URL=https://example.com/webhooks/graph/messages
WEBHOOK_CLIENT_STATE=replace-with-random-shared-secret

# OneDrive paths
ONEDRIVE_CAD_TEMPLATE_PATH=CMR Design/cipi - CAD Files/000 New/00Template
ONEDRIVE_CAD_DESTINATION_PATH=CMR Design/cipi - CAD Files
ONEDRIVE_CLIENT_TEMPLATE_PATH=CMR Design/cipi - CMR Design/00New/01Template
ONEDRIVE_CLIENT_DESTINATION_PATH=CMR Design/Client Files
ONEDRIVE_CLIENT_PRODUCTION_PATH=CMR Design/Client Files/Production

# Contract verification
SIGNED_KEYWORD=Zoho signed document ID
UNSIGNED_KEYWORD=unsigned

# Manual checkpoint owner
MANUAL_CHECKPOINT_OWNER_EMAIL=satyamshukla4916@gmail.com

